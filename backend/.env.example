APP_NAME=HUFS Recycle API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BUSINESS_TIMEZONE=Asia/Seoul

DATABASE_URL=sqlite:///./dev.db

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALLOWED_EMAIL_DOMAINS=hufs.ac.kr
QR_SIGNING_SECRET=replace-with-a-long-random-qr-signing-secret

ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

EMAIL_VERIFICATION_MODE=development
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

DAILY_SUBMISSION_LIMIT=2
SUBMISSION_COOLDOWN_MINUTES=60
POINTS_PER_APPROVAL=1
DEMO_AUTO_APPROVE_SUBMISSIONS=false
DEFAULT_ALLOWED_RADIUS_M=30
MAX_GPS_ACCURACY_M=100
MAX_IMAGE_SIZE_MB=5
SIGNED_IMAGE_URL_EXPIRE_SECONDS=300

STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=submission-images

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=관리자
SEED_ADMIN_STUDENT_NUMBER=ADMIN001

SEED_LOCATION_NAME=교내 테스트 분리수거함
SEED_LOCATION_DESCRIPTION=개발 테스트 장소
SEED_LOCATION_LATITUDE=
SEED_LOCATION_LONGITUDE=
SEED_LOCATION_ALLOWED_RADIUS_M=30
